# ----------------------------------------------------------------
# apps/ops — environment variable reference
# Copy to .env.local and fill in values for local development.
# Never commit .env.local or any file containing real values.
# In production, secrets are injected via Docker Swarm secrets
# and read at startup by src/instrumentation.ts.
# ----------------------------------------------------------------

# Keycloak
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ISSUER=
# Optional — defaults to 4 hours (14400 seconds)
KEYCLOAK_MAX_SESSION_AGE=

# NextAuth
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_URL_INTERNAL=http://localhost:3001
NEXTAUTH_DEFAULT_REDIRECT=/
AUTH_TRUST_HOST=true

# Access control
WHITELISTED_EMAIL_DOMAINS=ebikesafrica.co.ke

# Backend services
IAM_SERVICE_BASE_URL=http://localhost:8085
NOTIFICATIONS_SERVICE_BASE_URL=http://localhost:8086
ORGANIZATIONS_SERVICE_BASE_URL=http://localhost:8087
MAKER_CHECKER_SERVICE_BASE_URL=http://localhost:8088
ORDERS_SERVICE_BASE_URL=http://localhost:8089
WORKFORCE_SERVICE_BASE_URL=http://localhost:8091

# S3 CSP origins
S3_CSP_ORIGIN_ORDERS=
S3_CSP_ORIGIN_ORGANIZATIONS=
S3_CSP_ORIGIN_WORKFORCE=

# Observability — optional in local development
OTEL_SERVICE_NAME=ebikes-ops
OTEL_EXPORTER_OTLP_ENDPOINT=
NEXT_OTEL_VERBOSE=0
NEXT_TELEMETRY_DISABLED=1

# Runtime
NODE_ENV=development
DEPLOY_ENV=dev
HOSTNAME=0.0.0.0
