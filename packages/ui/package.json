{
  "name": "@repo/ui",
  "version": "0.0.0",
  "private": true,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./primitives/*": {
      "types": "./src/components/primitives/*.tsx",
      "default": "./src/components/primitives/*.tsx"
    },
    "./dates/*": {
      "types": "./src/components/dates/*.tsx",
      "default": "./src/components/dates/*.tsx"
    },
    "./dialogs/*": {
      "types": "./src/components/dialogs/*.tsx",
      "default": "./src/components/dialogs/*.tsx"
    },
    "./errors/*": {
      "types": "./src/components/errors/*.tsx",
      "default": "./src/components/errors/*.tsx"
    },
    "./inputs/*": {
      "types": "./src/components/inputs/*.tsx",
      "default": "./src/components/inputs/*.tsx"
    },
    "./navigation/*": {
      "types": "./src/components/navigation/*.tsx",
      "default": "./src/components/navigation/*.tsx"
    },
    "./tables/*": {
      "types": "./src/components/tables/*.tsx",
      "default": "./src/components/tables/*.tsx"
    },
    "./tables/controls/*": {
      "types": "./src/components/tables/controls/*.tsx",
      "default": "./src/components/tables/controls/*.tsx"
    },
    "./tables/states/*": {
      "types": "./src/components/tables/states/*.tsx",
      "default": "./src/components/tables/states/*.tsx"
    },
    "./hooks": {
      "types": "./src/hooks/index.ts",
      "default": "./src/hooks/index.ts"
    },
    "./hooks/*": {
      "types": "./src/hooks/*.ts",
      "default": "./src/hooks/*.ts"
    },
    "./utilities": {
      "types": "./src/utilities/index.ts",
      "default": "./src/utilities/index.ts"
    },
    "./utilities/*": {
      "types": "./src/utilities/*.ts",
      "default": "./src/utilities/*.ts"
    },
    "./types": {
      "types": "./src/types/index.ts",
      "default": "./src/types/index.ts"
    },
    "./types/*": {
      "types": "./src/types/*.ts",
      "default": "./src/types/*.ts"
    },
    "./styles/*": {
      "default": "./src/styles/*"
    },
    "./globals.css": {
      "default": "./src/styles/globals.css"
    }
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf .turbo node_modules"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/shared": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.2.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "input-otp": "^1.4.2",
    "libphonenumber-js": "^1.12.42",
    "lucide-react": "^1.14.0",
    "maplibre-gl": "^5.24.0",
    "next-themes": "^0.4.6",
    "react-day-picker": "^9.13.0",
    "react-phone-number-input": "^3.4.14",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7"
  }
}